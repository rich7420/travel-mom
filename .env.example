APP_ENV=dev
TRAVEL_DESK_DB=./data/travel_desk.db
PUBLIC_BASE_URL=http://localhost:8000

# Operator API protection. Required when APP_ENV=production.
# Mom Mode and the admin workbench ask for this only when operator auth is enabled.
TRAVEL_DESK_ADMIN_TOKEN=
MAX_REQUEST_BODY_BYTES=1000000
INBOUND_EVENT_LEASE_SECONDS=120

# OpenClaw Gateway — backend only; keep on loopback/private network.
OPENCLAW_ENABLED=false
OPENCLAW_BASE_URL=http://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=mom-travel
OPENCLAW_MODEL=openclaw/mom-travel
# Dedicated least-privilege browser agent. Keep this separate from the conversational agent.
OPENCLAW_BROWSER_MODEL=openclaw/mom-travel-browser
# v0.8.1 default is the isolated managed profile. Override to chrome/user only when a legal signed-in session is required.
OPENCLAW_BROWSER_PROFILE=openclaw

# LINE Official Account
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_ALLOWED_USER_IDS=

# Telegram bot (admin/backup)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Set the same value in Telegram setWebhook(secret_token=...).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

# Encrypt local PII payloads in the POC. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_FERNET_KEY=

# Optional EXTRA domains for hotel/other provider experiments.
# The v0.8.1 airline registry allowlists CI/BR/CX/JX/AE/IT/EK/NH official domains.
# Built-in hotel networks + human-approved independent HotelSiteGrants are handled separately.
# Unknown domains are denied by default.
BROWSER_ALLOWED_DOMAINS=

# Browser Lab raw-result ingest is development-only. It is forcibly disabled in APP_ENV=production.
BROWSER_LAB_INGEST_ENABLED=true

# Revalidation must be this fresh before booking preflight can pass.
PRICE_REVALIDATION_MAX_AGE_MINUTES=20
# Any TWD price delta above this threshold requires explicit acceptance (0 = every change).
PRICE_CHANGE_ACCEPTANCE_THRESHOLD_TWD=0

# Reference offers without an explicit supplier expiry need refreshing after this age.
# Separate from the stricter 20-minute booking preflight revalidation check.
QUOTE_MAX_AGE_HOURS=24

# Public tunnel deployment: enable Cloudflare Access at the edge AND JWT verification here.
# token = local/private compatibility mode; cloudflare = per-user login and roles.
AUTH_MODE=token
CLOUDFLARE_ACCESS_ISSUER=
CLOUDFLARE_ACCESS_AUDIENCE=
CLOUDFLARE_ACCESS_EMAILS=
CLOUDFLARE_ACCESS_ADMIN_EMAILS=

# Defaults live beside TRAVEL_DESK_DB. Keep outside static/public paths.
ATTACHMENTS_DIR=
BACKUP_DIR=

# Independent outbound reminder worker. Keep disabled until sender accounts are verified.
REMINDERS_ENABLED=false
REMINDER_LINE_ENABLED=false
REMINDER_SMTP_ENABLED=false
REMINDER_STAFF_EMAILS=
REMINDER_GRACE_MINUTES=30
REMINDER_SMTP_HOST=
REMINDER_SMTP_PORT=465
REMINDER_SMTP_TLS=ssl
REMINDER_SMTP_USER=
REMINDER_SMTP_PASSWORD=
REMINDER_SMTP_FROM=
